{
  "name": "dabblecad",
  "productName": "DabbleCAD Plus",
  "version": "1.2.0",
  "description": "One offline, open-source app for 3D design, laser projects, and depth maps. Tinkercad-style modeling; runs locally, no account needed.",
  "main": "electron/main.js",
  "author": "DJMcNewgent",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && node tools/run.js",
    "app": "node tools/run.js",
    "package": "npm run package:win",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "test": "vite build && node tools/run.js --smoke=tools/smoke3.js",
    "test:laser": "vite build && node tools/run.js --smoke=tools/smoke-laser.js",
    "test:depth": "vite build && node tools/run.js --smoke=tools/smoke-depth.js",
    "test:save": "vite build && node tools/run.js --smoke=tools/smoke-save.js",
    "test:all": "npm run build && node tools/test.js",
    "test:packaged": "node tools/test.js --packaged",
    "test:ai": "node tools/test-ai.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@fontsource/roboto": "^5.3.0",
    "clipper-lib": "^6.4.2",
    "electron": "^45.3.2",
    "electron-builder": "26.18.0",
    "manifold-3d": "^3.5.5",
    "openai": "^7.63.0",
    "opentype.js": "^2.0.0",
    "qrcode-generator": "^2.0.4",
    "three": "^0.187.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.18",
    "vite": "^8.3.8"
  },
  "homepage": "https://github.com/jonsole/DabbleCAD",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonsole/DabbleCAD.git"
  },
  "bugs": {
    "url": "https://github.com/jonsole/DabbleCAD/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": true
}
